        "import torchcrepe\n",
        "import torch\n",
        "\n",
        "def get_f0_crepe(audio, sr, hop_length=512):\n",
        "    \"\"\"\n",
        "    CREPE 모델을 이용한 고정밀 피치 트래킹\n",
        "    \"\"\"\n",
        "    # 1. GPU 설정\n",
        "    device = 'cuda' if torch.cuda.is_available() else 'cpu'\n",
        "\n",
        "    # 2. 오디오 텐서 변환 및 차원 추가 (Batch, Channel, Time)\n",
        "    # torchcrepe는 [1, 1024] 같은 형태가 아니라 [1, audio_len]을 원함\n",
        "    audio_tensor = torch.tensor(audio).unsqueeze(0).to(device)\n",
        "\n",
        "    # 3. CREPE 실행 (Full 모델 사용 권장)\n",
        "    # fmin=30 (Low B가 약 30Hz), fmax=500 (베이스 고음)\n",
        "    f0, confidence = torchcrepe.predict(\n",
        "        audio_tensor,\n",
        "        sr,\n",
        "        hop_length=hop_length,\n",
        "        fmin=30,\n",
        "        fmax=500,\n",
        "        model='full',\n",
        "        decoder=\"viterbi\", # 비터비 알고리즘으로 급격한 피치 튀는 현상 방지\n",
        "        return_periodicity=True,\n",
        "        device=device,\n",
        "        batch_size=2048\n",
        "    )\n",
        "\n",
        "    # 4. 결과 정제\n",
        "    f0 = f0.squeeze().cpu().numpy()\n",
        "    confidence = confidence.squeeze().cpu().numpy()\n",
        "\n",
        "    # 신뢰도가 낮은 구간(잡음, 무음)은 NaN(없음) 처리\n",
        "    # 베이스는 소리가 명확하므로 0.6~0.7 정도면 적당\n",
        "    f0[confidence < 0.6] = np.nan\n",
        "\n",
        "    return f0"
      ],
